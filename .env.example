# Supabase project credentials — Dashboard → Project Settings → API
# Copy this file to .env.local for local development, and add the same two
# variables in Vercel under Project Settings → Environment Variables.
#
# Both values are shipped to the browser (that is what the anon key is for).
# Never put the service_role key in a VITE_-prefixed variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
